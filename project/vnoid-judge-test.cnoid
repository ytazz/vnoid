items:
  id: 0
  name: "RootItem"
  plugin: Base
  class: RootItem
  is_builtin_item: true
  children:
    -
      id: 1
      name: "World"
      plugin: Body
      class: WorldItem
      is_checked: true
      data:
        collision_detection: false
        collision_detector: AISTCollisionDetector
        default_material_table_file: "${SHARE}/default/materials.yaml"
      children:
        -
          id: 2
          name: "quadcopter"
          plugin: Body
          class: BodyItem
          is_checked: true
          data:
            file: "${SHARE}/model/multicopter/quadcopter.body"
            format: CHOREONOID-BODY
            current_base_link: "BODY"
            root_translation: [ 0, 0, 0.2 ]
            root_rotation: [ 1, 0, 0, 0 ]
            joint_displacements: [ 0, 0, 0, 0, 0 ]
            initial_root_translation: [ 0, 0, 0.2 ]
            initial_root_rotation: [ 1, 0, 0, 0 ]
            fix_root: false
            collision_detection: true
            lock_location: false
            scene_sensitive: true
            show_bounding_box: true
          children:
            -
              id: 3
              name: "QuadcopterController"
              plugin: Body
              class: SimpleControllerItem
              data:
                controller: "QuadcopterController"
                base_directory: "Controller directory"
                reloading: false
                export_symbols: false
            -
              id: 4
              name: "BodyTrackingCamera"
              plugin: Body
              class: BodySyncCameraItem
              is_checked: true
              data:
                camera_type: Perspective
                translation: [ -1.68483, -0.934988, 0.850592 ]
                rotation: [ 0.686043, -0.410648, -0.600594, 89.8071 ]
                field_of_view: 0.785398
                near_clip_distance: 0.01
                far_clip_distance: 100
                interactive_viewpoint_change: true
                target_link: ""
                parallel_tracking: false
                local_translation: [ -1.68483, -0.934988, 0.650592 ]
                local_rotation: [ 0.686043, -0.410648, -0.600594, 89.8071 ]
            -
              id: 5
              name: "JudgeTarget"
              plugin: VnoidJudge
              class: VnoidJudgeTargetItem
              data:
                power_limit_w: 1000
                mass_lower_limit: 30
                bbox_upper_limit: [ 2, 2, 2 ]
        -
          id: 6
          name: "HVAC2023_athletics_field"
          plugin: Body
          class: BodyItem
          is_checked: true
          data:
            file: "${SHARE}/model/field2023/field2023_athletics.body"
            format: CHOREONOID-BODY
            root_translation: [ 0, 0, 0 ]
            root_rotation: [ 1, 0, 0, 0 ]
            joint_displacements: [ 2.02361e-06, 0, 4.99478e-06, 0, -7.1689e-08 ]
            initial_joint_displacements: [ 0, 0, 0, 0, 0 ]
            initial_root_translation: [ 0, 0, 0 ]
            initial_root_rotation: [ 1, 0, 0, 0 ]
            fix_root: true
            collision_detection: true
            lock_location: true
            scene_sensitive: true
        -
          id: 7
          name: "AISTSimulator"
          plugin: Body
          class: AISTSimulatorItem
          data:
            time_step: 0.005
            realtime_sync_mode: compensatory
            recording: tail
            time_range_mode: unlimited
            time_length: 300
            is_active_control_time_range_mode: true
            output_all_link_positions: false
            output_device_states: true
            use_controller_threads: true
            record_collision_data: false
            controller_options: ""
            block_scene_view_edit_mode: false
            dynamics_mode: "Forward dynamics"
            integration_mode: semi-implicit_euler
            gravity: [ 0, 0, -9.80665 ]
            min_friction_coefficient: 0
            max_friction_coefficient: 100
            contact_culling_distance: 0.005
            contact_culling_depth: 0.05
            error_criterion: 0.001
            max_num_iterations: 10
            num_collision_detection_threads: 0
            max_num_contact_points: 4
            contact_correction_depth: 0.00025
            contact_correction_velocity_ratio: 5
            drive_effort_output: true
          children:
            -
              id: 8
              name: "MulticopterSimulator"
              plugin: Multicopter
              class: MulticopterSimulatorItem
              data:
                enabled: true
                Fluid Density[kg/m^3]: 1.293
                Viscosity[Pa*s]: 1.7e-05
                Fluid Velocity[m/s]: [ 0, 0, 0 ]
                Air Definition File: ""
                Wall Effect: false
                Ground Effect: false
                Output Parameter: false
                Output Time Step[s]: 1
            -
              id: 9
              name: "VnoidJudge"
              plugin: VnoidJudge
              class: VnoidJudgeItem
              is_checked: true
              data:
                enabled: true
                power_average_window: 0.01
                log_file: ""
                show_section_bounding_boxes: true
                hud_font_size: 18
                hud_text_color: [ 1, 1, 1 ]
                hud_panel_transparency: 0.4
views:
  -
    id: 0
    plugin: Base
    class: ItemPropertyView
    mounted: true
  -
    id: 1
    plugin: Base
    class: ItemTreeView
    mounted: true
    state:
      expanded: [ 1, 2, 6, 7 ]
  -
    id: 2
    plugin: Base
    class: LocationView
    mounted: true
    state:
      show_rpy: true
      unique_rpy: false
      show_quaternion: false
      show_rotation_matrix: false
      coordinate: world
  -
    id: 3
    plugin: Base
    class: MessageView
    mounted: true
  -
    id: 4
    plugin: Base
    class: SceneView
    mounted: true
    state:
      operation_mode: view
      viewpoint_operation_mode: third_person
      focus_position: [ 0.0258906, -0.369574, 1.56666e-06 ]
      visible_polygon_elements: [ face ]
      highlighting: false
      collision_highlighting: false
      collision_lines: false
      cameras:
        -
          camera: Perspective
          is_current: true
          eye: [ -4.58905, 12.1749, 8.49972 ]
          direction: [ 0.606034, -0.646825, -0.462968 ]
          up: [ 0.316542, -0.337848, 0.886375 ]
        -
          camera: Orthographic
          ortho_height: 0.837436
      lighting_mode: normal
      culling_mode: enabled
      shading_mode: smooth
      world_light: true
      world_light_intensity: 0.7
      ambient_light: true
      ambient_light_intensity: 0.2
      head_light: true
      head_light_intensity: 0.7
      world_light_shadow: true
      shadow_lights:
        - { index: 0, enabled: false }
        - { index: 1, enabled: false }
      background_color: [ 0.1, 0.1, 0.3 ]
      line_width: 1
      point_size: 1
      field_of_view: 39.981
      clip_distances: [ 0.01, 10000 ]
      infinite_far_clip: true
      floor_grid: false
      floor_grid_span: 10
      floor_grid_interval: 0.5
      xz_grid: false
      xz_grid_span: 10
      xz_grid_interval: 0.5
      yz_grid: false
      yz_grid_span: 10
      yz_grid_interval: 0.5
      xy_grid_color: [ 0.9, 0.9, 0.9 ]
      xz_grid_color: [ 0.9, 0.9, 0.9 ]
      yz_grid_color: [ 0.9, 0.9, 0.9 ]
  -
    id: 5
    plugin: Base
    class: VirtualJoystickView
    mounted: true
  -
    id: 6
    plugin: Body
    class: JointDisplacementView
    mounted: true
    state:
      show_joint_ids: true
      show_joint_names: false
      overlap_joint_names: false
      show_sliders: true
      show_dials: false
      show_phases: true
      limit_ranges: false
      show_selected_joints: false
  -
    id: 7
    plugin: Body
    class: LinkDeviceListView
    mounted: true
    state:
      element_type: device
      listing_mode: list
  -
    id: 8
    plugin: Body
    class: LinkPositionView
    state:
      coordinate_mode: world
      preferred_coordinate_mode: base
      show_rpy: true
      unique_rpy: false
      show_quaternion: false
      show_rotation_matrix: false
      target_link_type: ik_link
  -
    id: 9
    plugin: Body
    class: LinkPropertyView
  -
    id: 10
    plugin: Python
    class: PythonConsoleView
    mounted: true
toolbars:
  "TimeBar":
    current_time: 0
    min_time: 0
    max_time: 51.083
    frame_rate: 1000
    playback_frame_rate: 60
    idle_loop_driven_mode: false
    playback_speed_ratio: 1
    sync_to_ongoing_updates: true
    auto_expansion: true
  "LeggedBodyBar":
    stanceWidth: 0.15
  "KinematicsBar":
    forward_kinematics: true
    inverse_kinematics: true
    preset_kinematics: true
    enablePositionDragger: true
    penetrationBlock: false
    snapDistance: 0.025
    penetrationBlockDepth: 0.0005
    lazyCollisionDetectionMode: true
Body:
  "BodySelectionManager":
    current_body_item: 2
    current_link: "BODY"
  "KinematicFaultChecker":
    checkJointPositions: true
    angleMargin: 0
    translationMargin: 0
    checkJointVelocities: true
    velocityLimitRatio: 100
    targetJoints: all
    checkSelfCollisions: true
    onlyTimeBarRange: false
  "OperableSceneBody":
    scene_bodies:
      -
        body_item: 2
        show_cm: false
        show_cm_projection: false
        show_zmp: false
      -
        body_item: 6
        show_cm: false
        show_cm_projection: false
        show_zmp: false
  "SplineFilterDialog":
    isInputFrameRateSpecified: false
    inputFrameRate: 200
    isOutputFrameRateSpecified: false
    outputFrameRate: 200
view_areas:
  -
    type: embedded
    tabs: true
    contents:
      type: splitter
      orientation: horizontal
      sizes: [ 315, 1440 ]
      children:
        -
          type: splitter
          orientation: vertical
          sizes: [ 457, 656 ]
          children:
            -
              type: pane
              views: [ 1 ]
            -
              type: pane
              views: [ 0, 7 ]
              current: 0
        -
          type: splitter
          orientation: vertical
          sizes: [ 794, 319 ]
          children:
            -
              type: splitter
              orientation: horizontal
              sizes: [ 1166, 270 ]
              children:
                -
                  type: pane
                  views: [ 4 ]
                -
                  type: splitter
                  orientation: vertical
                  sizes: [ 395, 395 ]
                  children:
                    -
                      type: pane
                      views: [ 2 ]
                    -
                      type: pane
                      views: [ 6 ]
            -
              type: splitter
              orientation: horizontal
              sizes: [ 718, 718 ]
              children:
                -
                  type: pane
                  views: [ 3, 10 ]
                  current: 3
                -
                  type: pane
                  views: [ 5 ]
toolbar_layout:
  rows:
    -
      - { name: "FileBar", x: 0, priority: 0 }
      - { name: "ScriptBar", x: 0, priority: 1 }
      - { name: "SimulationBar", x: 0, priority: 2 }
      - { name: "TimeBar", x: 0, priority: 0 }
    -
      - { name: "BodyBar", x: 0, priority: 0 }
      - { name: "KinematicsBar", x: 0, priority: 1 }
      - { name: "SceneBar", x: 0, priority: 2 }
      - { name: "GraphBar", x: 0, priority: 3 }
      - { name: "CaptureBar", x: 0, priority: 4 }
      - { name: "DisplayValueFormatBar", x: 0, priority: 5 }
